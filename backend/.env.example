# Copy this file to .env.local and replace placeholder values locally.
# Never commit .env.local or a real API key.

# Core application
MONGO_URI=your_mongodb_connection_string
SESSION_SECRET=replace_with_a_long_random_session_secret
JWT_SECRET=replace_with_a_long_random_jwt_secret
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
TRUST_PROXY=0

# AI provider pool: only providers with a key are used.
LLM_POOL=gemini,groq,openrouter,cerebras
REPORT_PREFER_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
# Optional fallback: leave blank unless you have a valid Cerebras key.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Retrieval-augmented generation and document extraction
EMBED_POOL=gemini,openrouter
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768
GEMINI_EXTRACT_MODEL=gemini-3.6-flash

# Request and upload safeguards
API_RATE_MAX=600
GEN_RATE_MAX=30
UPLOAD_RATE_MAX=10
REPORT_UPLOAD_MAX_FILES=8
REPORT_UPLOAD_MAX_FILE_BYTES=15728640
REPORT_UPLOAD_MAX_TOTAL_BYTES=52428800
MAX_REMOTE_SOURCE_BYTES=20971520

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Optional prompt override for the wellness companion
PROMPT=You are a supportive AI companion that provides empathetic, non-medical mental wellness support.
